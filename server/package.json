{
  "name": "zeolite-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file=.env src/index.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write src test eslint.config.js",
    "format:check": "prettier --check src test eslint.config.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7"
  }
}
