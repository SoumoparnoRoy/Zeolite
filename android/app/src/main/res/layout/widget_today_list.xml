<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and up. The rows are handed over inside the same update as
    everything else (RemoteCollectionItems), so there is no adapter service to
    re-attach or to miss a refresh, which is what sank the earlier list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <ListView
        android:id="@+id/today_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/today_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
