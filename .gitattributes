# Normalise to LF in the repository so the tree is identical on every OS.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or they break when executed.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets: never touch these.
*.png  binary
*.jpg  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.jar  binary
*.keystore binary
*.jks  binary

# Collapse the lockfile in GitHub diffs without hiding it from git itself.
pubspec.lock linguist-generated=true

# Developer tooling rather than shipped source.
tool/**     linguist-vendored=true
