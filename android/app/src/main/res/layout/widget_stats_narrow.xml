<?xml version="1.0" encoding="utf-8"?>
<!-- widget_stats at two columns: the figure takes its own line, because beside
     it the verdict had less room than one word. Same ids, so the provider fills
     either layout the same way. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stats_root"
    android:background="@drawable/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/stats_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/stats_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stats_verdict"
            android:textColor="@color/widget_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stats_next"
            android:textColor="@color/widget_text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textSize="10.5sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/stats_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/stats_empty"
        android:visibility="gone"
        android:textColor="@color/widget_text_tertiary"
        android:text="@string/widget_empty_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="13sp" />
</LinearLayout>
