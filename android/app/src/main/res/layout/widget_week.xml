<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/week_root"
    android:background="@drawable/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The grid takes the whole cell, edge to edge: it is drawn at this
         box's own size, so it fills rather than being centred in it. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/week_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_week_title" />

        <!-- Hidden by default, and shown by the provider only when there is
             no image. Left visible it sits over the grid for the one frame
             between the launcher inflating this XML and applying the actions
             that hide it, which read as the widget flickering on every mark. -->
        <TextView
            android:id="@+id/week_placeholder"
            android:visibility="gone"
            android:textColor="@color/widget_text_tertiary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/widget_week_placeholder"
            android:textSize="13sp" />

        <!-- The grid is a render, so the only tap targets it can offer are
             these seven transparent columns laid over it, one per day. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/week_day_0"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"></FrameLayout>
            <FrameLayout android:id="@+id/week_day_1"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"></FrameLayout>
            <FrameLayout android:id="@+id/week_day_2"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"></FrameLayout>
            <FrameLayout android:id="@+id/week_day_3"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"></FrameLayout>
            <FrameLayout android:id="@+id/week_day_4"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"></FrameLayout>
            <FrameLayout android:id="@+id/week_day_5"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"></FrameLayout>
            <FrameLayout android:id="@+id/week_day_6"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"></FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
