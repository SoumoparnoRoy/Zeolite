android/.kotlin/

# Signing / secrets / env
# Never commit these. Anything matching is a private key or a credential.
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.crt
key.properties
.env
.env.*
*.env
secrets.dart
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart

# Desktop/web generated output
windows/flutter/ephemeral/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
ios/Flutter/ephemeral/

# Firebase CLI deploy cache — regenerated on every `firebase deploy`.
.firebase/

# Symbol tool the Crashlytics Gradle plugin downloads on a release build.
.crashlytics/

# OS noise
.DS_Store
Thumbs.db
desktop.ini
