<?xml version="1.0" encoding="utf-8"?>
<!--
    The picker only, never a placed widget. It uses invented classes rather
    than the live data that fills a placed widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:background="@color/widget_preview_subject_1"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:minHeight="44dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Subject 1"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="09:10 - 10:00"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:background="@drawable/widget_button"
            android:backgroundTint="@color/widget_preview_present_fill"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_present_short"
            android:textColor="@color/widget_present"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:background="@drawable/widget_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_absent_short"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:background="@drawable/widget_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_cancelled_short"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:background="@color/widget_preview_subject_2"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:minHeight="44dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Subject 2"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="10:10 - 11:00"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:background="@drawable/widget_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_present_short"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:background="@drawable/widget_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_absent_short"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:background="@drawable/widget_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_cancelled_short"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:background="@color/widget_preview_subject_3"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:minHeight="44dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Subject 3"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="11:10 - 12:00"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:background="@drawable/widget_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_present_short"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:background="@drawable/widget_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_absent_short"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:background="@drawable/widget_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_cancelled_short"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:background="@color/widget_preview_subject_4"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:minHeight="44dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Subject 4"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="12:10 - 13:00"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:background="@drawable/widget_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_present_short"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:background="@drawable/widget_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_absent_short"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:background="@drawable/widget_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_cancelled_short"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
