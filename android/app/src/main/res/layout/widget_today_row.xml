<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_card"
    android:background="@color/widget_surface"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <FrameLayout
        android:id="@+id/row_stripe"
        android:background="@color/widget_accent"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:minHeight="44dp" />

    <LinearLayout
        android:id="@+id/row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/row_subject"
            android:textColor="@color/widget_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_meta"
            android:textColor="@color/widget_text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_present"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="66dp"
        android:gravity="center"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:layout_marginEnd="6dp"
        android:text="@string/widget_present"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/row_absent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="56dp"
        android:gravity="center"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:layout_marginEnd="6dp"
        android:text="@string/widget_absent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/row_cancelled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="66dp"
        android:gravity="center"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:layout_marginEnd="8dp"
        android:text="@string/widget_cancelled"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
