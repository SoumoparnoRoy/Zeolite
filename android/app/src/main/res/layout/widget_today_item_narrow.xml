<?xml version="1.0" encoding="utf-8"?>
<!-- Under about 260dp three 40dp buttons leave the subject no room beside
     them, so in a narrow cell they go underneath it and share the width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="8dp">

    <FrameLayout
        android:id="@+id/item_stripe"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/widget_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/item_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="2dp"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_present"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button"
                android:contentDescription="@string/widget_present"
                android:gravity="center"
                android:text="@string/widget_present_short"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_absent"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button"
                android:contentDescription="@string/widget_absent"
                android:gravity="center"
                android:text="@string/widget_absent_short"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_cancelled"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button"
                android:contentDescription="@string/widget_cancelled"
                android:gravity="center"
                android:text="@string/widget_cancelled_short"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
