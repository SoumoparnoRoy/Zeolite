<?xml version="1.0" encoding="utf-8"?>
<!-- widget_stats_row at two columns: the name gets the full width and the
     percentage a line of its own under it. Beside the counts, two decimal
     places squeezed "7 of 12 attended" into a column of fragments. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stat_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/stat_stripe"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:minHeight="30dp" />

    <LinearLayout
        android:id="@+id/stat_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/stat_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stat_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stat_counts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/stat_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="1dp"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
